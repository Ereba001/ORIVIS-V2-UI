{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills",
      "~/.agents/skills",
      "~/.config/opencode/skills",
      "~/.config/opencode/skills/borghei-claude-skills"
    ]
  },
  "compaction": {
    "auto": true,
    "tail_turns": 20
  },
  "tool_output": {
    "max_lines": 100,
    "max_bytes": 8192
  },
  "mcp": {
    "context-watch": {
      "type": "local",
      "command": ["node", ".opencode/mcp/context-watch/server.js"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\Hp\\Desktop\\orivis v2\\ORIVIS-V2-UI"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp", "--api-key", "YOUR_CONTEXT7_API_KEY"],
      "enabled": false
    }
  },
  "agent": {
    "plan": {
      "description": "Read and plan before executing. No file changes allowed.",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "write": "deny"
      }
    },
    "build": {
      "description": "Execute planned work. Full file access.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "write": "allow"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "external_directory": {
      "*": "ask"
    }
  },
  "instructions": ["AGENTS.md", ".opencode/skills/context-management/SKILL.md"]
}
