# ---------------------------------------------------------------------------
# ORIVIS V2 UI — environment variables
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the service URL.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# VITE_API_URL: The deployed API base URL including /api/v1, e.g.
#   VITE_API_URL="https://api.orivis.ng/api/v1"
# OPTIONAL. When unset the app uses the same-origin '/api/v1' base:
#   - Dev:  Vite proxies /api to the Laravel dev server (see vite.config.ts).
#   - Prod: vercel.ts rewrites /api/* to the backend origin (ORIVIS_API_ORIGIN).
# Only set this when the browser should call the API origin directly. That
# requires CORS_ALLOWED_ORIGINS on the backend plus SESSION_SECURE_COOKIE=true,
# SESSION_SAME_SITE=none and SESSION_DOMAIN for cross-origin cookies.
# VITE_API_URL=""

# VITE_PROXY_TARGET: Dev-only. Backend the Vite dev proxy forwards /api to
# when VITE_API_URL is unset. Never set this in production builds.
# VITE_PROXY_TARGET="http://localhost:8000"

# ORIVIS_API_ORIGIN: NOT a Vite variable. Set in the Vercel project settings
# (Settings -> Environment Variables); vercel.ts uses it for the same-origin
# /api/* rewrite to the Laravel host, e.g. https://api.orivis.ng
